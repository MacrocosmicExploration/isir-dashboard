// Query name: ISIR_ReporterOrgSelfTest | Enable load: OFF
// Synthetic data only. Expected: 30 PASS rows. Requires both function queries.
let
    Employees = #table(type table [EMAILADDRESS = nullable text, ACTIVEDIRECTORYDISPLAYNAME = nullable text, EMPLOYEE_STATUS = nullable text], {
        {"alpha@example.invalid", "TEL FS SAMPLE, ALPHA", " Active "},
        {"alpha@example.invalid", "TEA FS SAMPLE, OLD", "Inactive"},
        {"dup@example.invalid", "TEA FS SAMPLE, ONE", "Active"},
        {"DUP@example.invalid", "TEH FS SAMPLE, TWO", "ACTIVE"},
        {"empty@example.invalid", null, "Active"},
        {null, "TEA FS SAMPLE, NOEMAIL", "Active"},
        {"single@example.invalid", "SAMPLE", "Active"},
        {"old@example.invalid", "TEH FS SAMPLE, OLD", "Inactive"},
        {"nostatus@example.invalid", "TEA FS SAMPLE, NONE", null},
        {"unknown@example.invalid", "TEA FS SAMPLE, UNKNOWN", "Pending"},
        {"isir-test-alias@us.tel.com", "TEA FS SAMPLE, ALIAS", "Active"},
        {"isir-test-reverse@tel.com", "TEH FS SAMPLE, REVERSE", "Active"},
        {"isir-test-both@tel.com", "TEA FS SAMPLE, EXACT", "Active"},
        {"isir-test-both@us.tel.com", "TEH FS SAMPLE, ALTERNATE", "Active"},
        {"isir-test-aliasdup@us.tel.com", "TEA FS SAMPLE, DUP1", "Active"},
        {"isir-test-aliasdup@us.tel.com", "TEH FS SAMPLE, DUP2", "Active"},
        {"isir-test-exactdup@tel.com", "TEA FS SAMPLE, DUP1", "Active"},
        {"isir-test-exactdup@tel.com", "TEH FS SAMPLE, DUP2", "Active"},
        {"isir-test-exactdup@us.tel.com", "TMEA FS SAMPLE, ALT", "Active"},
        {"isir-test-oldexact@tel.com", "TEA FS SAMPLE, OLD", "Inactive"},
        {"isir-test-oldexact@us.tel.com", "TMEA FS SAMPLE, CURRENT", "Active"},
        {"isir-test-foreign@tel.com", "TEA FS SAMPLE, FOREIGN", "Active"},
        {"duplicate-same@example.invalid", "TEA FS SAMPLE, SAME", "Active"},
        {"duplicate-same@example.invalid", "TEA FS SAMPLE, SAME", "Active"}
    }),
    Incidents = #table(type table [ID = Int64.Type, SourceItemID = Int64.Type, ReporterEmail = nullable text, ReporterSubsidiarySnapshot = nullable text, ReporterEmailAtCapture = nullable text], {
        {1, 101, " ALPHA@EXAMPLE.INVALID ", null, null},
        {2, 102, "alpha@example.invalid", " TEA ", "alpha@example.invalid"},
        {3, 103, "dup@example.invalid", null, null},
        {4, 104, null, null, null},
        {5, 105, "absent@example.invalid", null, null},
        {6, 106, "empty@example.invalid", null, null},
        {7, 107, "alpha@example.invalid", "   ", null},
        {8, 108, "absent@example.invalid", "TEH", "previous@example.invalid"},
        {9, 109, "single@example.invalid", null, null},
        {10, 110, "dup@example.invalid", "TMEA", "dup@example.invalid"},
        {11, 111, "old@example.invalid", null, null},
        {12, 112, "nostatus@example.invalid", null, null},
        {13, 113, "unknown@example.invalid", null, null},
        {14, 114, "isir-test-alias@tel.com", null, null},
        {15, 115, "isir-test-reverse@us.tel.com", null, null},
        {16, 116, "isir-test-both@tel.com", null, null},
        {17, 117, "isir-test-aliasdup@tel.com", null, null},
        {18, 118, "isir-test-exactdup@tel.com", null, null},
        {19, 119, "isir-test-oldexact@tel.com", null, null},
        {20, 120, "isir-test-foreign@example.invalid", null, null},
        {21, 121, "bad@@tel.com", null, null},
        {22, 122, "duplicate-same@example.invalid", null, null}
    }),
    T = fnISIRReporterOrgMatch(Incidents, Employees),
    Row = (id as number) as record => Table.SelectRows(T, each [ID] = id){0},
    BadIDs = try Table.RowCount(fnISIRReporterOrgMatch(Table.Combine({Incidents, Table.FirstN(Incidents,1)}), Employees)),
    BadSchema = try fnISIRReporterOrgMatch(Incidents, Table.RemoveColumns(Employees, {"EMPLOYEE_STATUS"})){0}[MatchStatus],
    WithoutSaved = fnISIRReporterOrgMatch(Table.SelectColumns(Table.FirstN(Incidents,1), {"ID", "SourceItemID", "ReporterEmail"}), Employees),
    Saved = #table(type table [SourceItemID = nullable number, ReporterSubsidiarySnapshot = nullable text, ReporterEmailAtCapture = nullable text], {{101, "TEH", "alpha@example.invalid"}}),
    Attached = fnISIRAttachOrgSnapshot(Incidents, Saved),
    AfterAttach = fnISIRReporterOrgMatch(Attached, Employees),
    BadSnapshot = try fnISIRAttachOrgSnapshot(Incidents, Table.Combine({Saved,Saved})){0}[ReporterSubsidiarySnapshot],
    Padding = #table(type table [SourceItemID = nullable number, ReporterSubsidiarySnapshot = nullable text, ReporterEmailAtCapture = nullable text], {{null,null,null}}),
    WithPadding = fnISIRAttachOrgSnapshot(Incidents, Table.Combine({Saved,Padding})),
    Partial = #table(type table [SourceItemID = nullable number, ReporterSubsidiarySnapshot = nullable text, ReporterEmailAtCapture = nullable text], {{null,"TEA",null}}),
    PartialSnapshot = try fnISIRAttachOrgSnapshot(Incidents, Partial){0}[ReporterSubsidiarySnapshot],
    Checks = {
        {"Case and whitespace normalize; inactive history ignored", Row(1)[ProposedReporterSubsidiary] = "TEL" and Row(1)[EmployeeMatchRows] = 1},
        {"Saved snapshot preserved exactly", Row(2)[ReporterSubsidiarySnapshot] = " TEA " and Row(2)[ProposedReporterSubsidiary] = null},
        {"Directory transfer flagged without overwrite", Row(2)[CurrentDirectoryDiffers] and Row(2)[Action] = "Keep existing snapshot"},
        {"Multiple active matches remain blocked", Row(3)[MatchStatus] = "Duplicate active employee email" and Row(3)[ProposedReporterSubsidiary] = null},
        {"Null email never joins null employee email", Row(4)[MatchStatus] = "Missing reporter email" and Row(4)[EmployeeMatchRows] = 0},
        {"Unmatched email remains unresolved", Row(5)[MatchStatus] = "No active employee match"},
        {"Missing and unsupported display names blocked", Row(6)[ProposedReporterSubsidiary] = null and Row(9)[ProposedReporterSubsidiary] = null},
        {"Whitespace-only saved value can be filled", Row(7)[ProposedReporterSubsidiary] = "TEL"},
        {"Saved snapshot survives employee departure", Row(8)[Action] = "Keep existing snapshot" and Row(8)[ReporterEmailChangedSinceCapture]},
        {"Saved snapshot survives ambiguous directory", Row(10)[Action] = "Keep existing snapshot" and Row(10)[ProposedReporterSubsidiary] = null},
        {"Inactive-only employee not selected", Row(11)[MatchStatus] = "No active employee match"},
        {"Missing and unrecognized status not treated as Active", Row(12)[EmployeeMatchRows] = 0 and Row(13)[EmployeeMatchRows] = 0},
        {"tel.com to us.tel.com fallback", Row(14)[ProposedReporterSubsidiary] = "TEA" and Row(14)[MatchMethod] = "TEL domain alias"},
        {"us.tel.com to tel.com fallback", Row(15)[ProposedReporterSubsidiary] = "TEH" and Row(15)[MatchMethod] = "TEL domain alias"},
        {"Exact email wins when both domains exist", Row(16)[ProposedReporterSubsidiary] = "TEA" and Row(16)[MatchMethod] = "Exact email"},
        {"Ambiguous alternate-domain matches blocked", Row(17)[MatchStatus] = "Duplicate active employee email" and Row(17)[ProposedReporterSubsidiary] = null},
        {"Ambiguous exact match does not fall through to alias", Row(18)[ExactActiveRows] = 2 and Row(18)[AlternateActiveRows] = 1 and Row(18)[ProposedReporterSubsidiary] = null},
        {"Inactive exact does not block unique active alias", Row(19)[ProposedReporterSubsidiary] = "TMEA" and Row(19)[MatchMethod] = "TEL domain alias"},
        {"Other domains never use local-part-only matching", Row(20)[MatchStatus] = "No active employee match" and Row(20)[ReporterAlternateEmailKey] = null},
        {"Malformed email blocked", Row(21)[MatchStatus] = "Invalid reporter email"},
        {"Identical duplicate active rows still blocked", Row(22)[EmployeeMatchRows] = 2 and Row(22)[ProposedReporterSubsidiary] = null},
        {"No incident row multiplication", Table.RowCount(T) = Table.RowCount(Incidents)},
        {"Duplicate incident ID rejected", BadIDs[HasError]},
        {"Missing employee status column fails visibly", BadSchema[HasError]},
        {"Optional saved columns can be absent", WithoutSaved{0}[ProposedReporterSubsidiary] = "TEL"},
        {"External snapshot joins by source ID, not email", Attached{0}[ReporterSubsidiarySnapshot] = "TEH" and Table.RowCount(Attached) = Table.RowCount(Incidents)},
        {"External snapshot survives subsequent lookup", AfterAttach{0}[Action] = "Keep existing snapshot" and AfterAttach{0}[ProposedReporterSubsidiary] = null},
        {"Duplicate saved source keys rejected", BadSnapshot[HasError]},
        {"Blank Excel padding row ignored", Table.RowCount(WithPadding) = Table.RowCount(Incidents)},
        {"Partially filled snapshot without key rejected", PartialSnapshot[HasError]}
    },
    Base = #table(type table [Check = text, Passed = logical], Checks),
    Output = Table.AddColumn(Base, "Result", each if [Passed] then "PASS" else "FAIL", type text)
in
    Output
